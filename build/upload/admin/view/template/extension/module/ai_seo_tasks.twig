{{ header }}{{ column_left }}
<style>.ai-tasks{min-height:calc(100vh - 120px);padding-bottom:28px;background:linear-gradient(135deg,#f5f7fb,#eef3f9);color:#26364a}.ai-tasks .container-fluid{max-width:1400px}.ai-tasks .page-header{margin:0;background:transparent;border:0}.ai-tasks .page-header .container-fluid{padding-top:18px}.ai-tasks .breadcrumb{background:transparent}.task-shell{padding-top:22px}.task-hero{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px;padding:25px 28px;border-radius:18px;background:linear-gradient(135deg,#263a67,#5e3c97);box-shadow:0 18px 40px rgba(36,54,92,.2);color:#fff}.task-hero h2{margin:0 0 5px;font-size:24px;font-weight:800}.task-hero p{margin:0;color:#dfe7ff}.task-hero .btn{border-radius:9px;font-weight:700}.task-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:16px}.task-card{margin-bottom:16px;overflow:hidden;border:1px solid #e4eaf1;border-radius:14px;background:#fff;box-shadow:0 8px 22px rgba(42,63,90,.06)}.task-card h3{margin:0;padding:17px 19px;border-bottom:1px solid #e8edf3;color:#34465e;font-size:15px;font-weight:800}.task-card h3 i{margin-right:7px;color:#7654bb}.task-table{overflow:auto}.task-table table{min-width:650px;margin:0}.task-table th{border-top:0!important;background:#f7f9fc!important;color:#738297!important;font-size:10px}.task-table td,.task-table th{padding:12px 15px!important;vertical-align:middle!important}.task-table td{color:#52647a;font-size:12px}.score{padding:4px 8px;border-radius:99px;background:#f0ebfb;color:#6947ab;font-size:10px;font-weight:800}.empty{padding:26px;color:#8997a6;text-align:center}.cluster{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:16px}.cluster article{padding:14px;border:1px solid #e3e9f0;border-radius:10px;background:#fafbfd}.cluster small{display:block;color:#8391a0;font-size:10px;font-weight:800}.cluster b{display:block;margin-top:5px;color:#394d69;font-size:22px}.duplicate-list,.schema-list{margin:0;padding:10px 16px 16px;list-style:none}.duplicate-list li,.schema-list li{padding:11px 0;border-top:1px solid #edf1f5;color:#607187;font-size:12px}.duplicate-list li:first-child,.schema-list li:first-child{border-top:0}.tag{display:inline-block;margin-right:6px;padding:3px 6px;border-radius:8px;background:#fff0ec;color:#b4564d;font-size:10px;font-weight:800}.ok{color:#268a58}.bad{color:#bf584d}@media(max-width:850px){.ai-tasks{padding-bottom:18px}.task-shell{padding-top:16px}.task-hero{align-items:flex-start;flex-direction:column;padding:22px}.task-grid{grid-template-columns:1fr}}@media(max-width:480px){.cluster{grid-template-columns:1fr}}</style>
<main id="content" class="ai-tasks"><div class="page-header ai-seo-header"><div class="container-fluid"><h1><i class="fa fa-check-square-o"></i> SEO görev merkezi</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div><div class="container-fluid task-shell"><section class="task-hero"><div><h2>Öncelikli SEO iyileştirmeleri</h2><p>Eksik veri, yinelenen içerik, arama niyeti ve şema kontrollerini tek görünümde yönetin.</p></div><div><a href="{{ products_url }}" class="btn btn-default"><i class="fa fa-cube"></i> Ürünler</a> <a href="{{ categories_url }}" class="btn btn-default"><i class="fa fa-sitemap"></i> Kategoriler</a> <a href="{{ assistant_url }}" class="btn btn-primary"><i class="fa fa-magic"></i> Asistana dön</a></div></section><div class="task-grid"><div><section class="task-card"><h3><i class="fa fa-flag"></i> Öncelikli ürün görevleri</h3>{% if task_data.tasks %}<div class="task-table"><table class="table table-hover"><thead><tr><th>ÜRÜN</th><th>SKOR</th><th>EKSİK VERİ</th><th>ARAMA NİYETİ</th></tr></thead><tbody>{% for item in task_data.tasks %}<tr><td><b>{{ item.name }}</b></td><td><span class="score">{{ item.score }}/100</span></td><td>{{ item.missing ?: 'Temel alanlar tamam' }}</td><td>{{ item.intent }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty">Öncelikli ürün görevi bulunamadı.</div>{% endif %}</section><section class="task-card"><h3><i class="fa fa-copy"></i> Yinelenen içerik sinyalleri</h3>{% if task_data.duplicates %}<ul class="duplicate-list">{% for duplicate in task_data.duplicates %}<li><span class="tag">{{ duplicate.type }}</span>{{ duplicate.items|join(' • ') }}</li>{% endfor %}</ul>{% else %}<div class="empty">Yinelenen meta veya URL sinyali bulunamadı.</div>{% endif %}</section></div><div><section class="task-card"><h3><i class="fa fa-crosshairs"></i> Anahtar kelime niyeti</h3><div class="cluster">{% for label, count in task_data.clusters %}<article><small>{{ label|upper }}</small><b>{{ count }}</b></article>{% endfor %}</div></section><section class="task-card"><h3><i class="fa fa-code"></i> Şema işaretleme kontrolü</h3><ul class="schema-list"><li><i class="fa {{ task_data.schema.product ? 'fa-check-circle ok' : 'fa-times-circle bad' }}"></i> Product schema</li><li><i class="fa {{ task_data.schema.faq ? 'fa-check-circle ok' : 'fa-times-circle bad' }}"></i> FAQPage schema</li><li><i class="fa {{ task_data.schema.breadcrumb ? 'fa-check-circle ok' : 'fa-times-circle bad' }}"></i> BreadcrumbList schema</li></ul></section><section class="task-card"><h3><i class="fa fa-link"></i> İç bağlantı önerisi</h3><div class="empty">Ürün üretiminde aynı kategori ve ortak anahtar kelimeler üzerinden en fazla 5 ilgili ürün otomatik bağlanır. Görev listesindeki düşük skorlu ürünleri yeniden üreterek önerileri güncelleyebilirsiniz.</div></section></div></div></div></main>
{{ footer }}
