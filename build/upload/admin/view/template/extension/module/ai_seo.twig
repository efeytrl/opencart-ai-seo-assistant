{{ header }}{{ column_left }}
<main id="content" class="ai-seo-page">
  <div class="page-header ai-seo-header"><div class="container-fluid"><div class="pull-right ai-header-action-staging" aria-hidden="true"></div><h1><i class="fa fa-magic"></i> Yapay Zekâ SEO Asistanı</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid"><div id="alert"></div>
    <section class="ai-seo-intro"><div class="intro-icon"><i class="fa fa-magic"></i></div><div class="intro-copy"><span>SEO ÇALIŞMA ALANI</span><h2>Ürün sayfalarınızı daha hızlı hazırlayın.</h2><p>AI sağlayıcınızı bağlayın, mağaza bağlamını tanımlayın ve seçtiğiniz ürünler için SEO alanlarını tek işlemde oluşturun.</p></div><div class="intro-actions"><a href="{{ products_url }}" class="btn btn-success"><i class="fa fa-magic"></i> Ürün seçip üret</a><button type="button" class="btn btn-link" data-open-tab="connection"><i class="fa fa-plug"></i> Bağlantıyı ayarla</button></div></section>
    <section class="ai-seo-page-actions" id="ai-seo-actions"><div class="page-actions-copy"><span>HIZLI İŞLEMLER</span><b>SEO çalışma araçları</b></div><div class="page-actions-buttons"><a href="{{ tasks_url }}" class="btn action-secondary"><i class="fa fa-check-square-o"></i><span>Görev merkezi</span></a><a href="{{ how_url }}" class="btn action-secondary"><i class="fa fa-question-circle"></i><span>Nasıl çalışır?</span></a><a href="{{ products_url }}" class="btn action-secondary"><i class="fa fa-cubes"></i><span>Ürünlere git</span></a><button type="button" id="button-update" class="btn action-secondary update-action" data-current-version="{{ extension_version }}"><i class="fa fa-cloud-download"></i><span>Güncellemeleri denetle</span><em>v{{ extension_version }}</em></button><button type="button" id="button-save" class="btn action-primary"><i class="fa fa-save"></i><span>Ayarları kaydet</span></button></div></section>
    <section class="ai-seo-status"><article><span class="status-icon purple"><i class="fa fa-plug"></i></span><div><small>AI SAĞLAYICISI</small><strong id="provider-name">OpenRouter</strong><p id="provider-state"><i class="fa fa-circle"></i> API anahtarı bekleniyor</p></div></article><article><span class="status-icon blue"><i class="fa fa-crosshairs"></i></span><div><small>MAĞAZA PROFİLİ</small><strong id="profile-state">{% if settings.module_ai_seo_site_profile %}Hazır{% else %}Bekliyor{% endif %}</strong><p><i class="fa fa-circle"></i> Marka ve dil bağlamı</p></div><button type="button" class="btn btn-default btn-sm scan-trigger" title="Mağaza profilini tara"><i class="fa fa-refresh"></i></button></article><article><span class="status-icon green"><i class="fa fa-list-ol"></i></span><div><small>TOPLU İŞLEM SINIRI</small><strong><span id="limit-state">{{ settings.module_ai_seo_max_products|default('30') }}</span> ürün</strong><p><i class="fa fa-circle"></i> Her üretim oturumunda</p></div></article></section>
    <form id="form-ai-seo"><section class="ai-seo-workspace"><aside class="settings-nav"><span>AYARLAR</span><button type="button" class="settings-tab active" data-tab="connection"><i class="fa fa-plug"></i> AI bağlantısı</button><button type="button" class="settings-tab" data-tab="brand"><i class="fa fa-pencil"></i> Marka ve içerik</button><button type="button" class="settings-tab" data-tab="rules"><i class="fa fa-sliders"></i> Üretim kuralları</button><div class="settings-help"><i class="fa fa-lightbulb-o"></i><b>Başlamak için</b><p>Önce sağlayıcınızı bağlayın. Sonrasında profilinizi tarayıp ürün ekranından üretim yapın.</p></div></aside><div class="settings-body">
      <section class="settings-panel active" id="tab-connection"><div class="panel-heading"><span class="panel-icon"><i class="fa fa-plug"></i></span><div><h2>Yapay zekâ bağlantısı</h2><p>İçeriği üretecek sağlayıcıyı, API anahtarını ve modeli belirleyin.</p></div></div>
        <div class="provider-grid"><label class="provider-card"><input type="radio" name="provider" value="openrouter" {% if settings.module_ai_seo_provider == 'openrouter' or not settings.module_ai_seo_provider %}checked{% endif %}><span><img class="provider-logo provider-logo-openrouter" src="https://cdn.simpleicons.org/openrouter/24292F" alt="OpenRouter logosu"><strong>OpenRouter</strong><small>Farklı modellere tek API ile erişin</small><i class="fa fa-check"></i></span></label><label class="provider-card"><input type="radio" name="provider" value="openai" {% if settings.module_ai_seo_provider == 'openai' %}checked{% endif %}><span><img class="provider-logo provider-logo-openai" src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" alt="OpenAI logosu"><strong>OpenAI</strong><small>ChatGPT modelleriyle içerik üretin</small><i class="fa fa-check"></i></span></label><label class="provider-card"><input type="radio" name="provider" value="gemini" {% if settings.module_ai_seo_provider == 'gemini' %}checked{% endif %}><span><img class="provider-logo provider-logo-gemini" src="https://cdn.simpleicons.org/googlegemini/4285F4" alt="Google Gemini logosu"><strong>Google Gemini</strong><small>Gemini modelleriyle üretim yapın</small><i class="fa fa-check"></i></span></label></div>
        <div class="provider-panel provider-openrouter"><div class="info"><i class="fa fa-info-circle"></i><span><b>OpenRouter önerilir.</b> Birçok AI modelini tek sağlayıcı ayarıyla kullanabilirsiniz.</span></div><div class="form-grid three"><label class="form-field wide"><span>OpenRouter API anahtarı <em>Gerekli</em></span><div class="secret"><i class="fa fa-key"></i><input type="password" name="openrouter_key" value="{{ settings.module_ai_seo_openrouter_key }}" placeholder="sk-or-v1-…"><button type="button" class="reveal-key" title="Anahtarı göster"><i class="fa fa-eye"></i></button></div><small>Anahtar yalnızca yönetim panelinde kullanılır.</small></label><label class="form-field"><span>SEO modeli</span><input type="text" name="openrouter_model" value="{{ settings.module_ai_seo_openrouter_model|default('openai/gpt-4o-mini') }}" placeholder="openai/gpt-4o-mini"></label><div class="form-field"><span>&nbsp;</span><button type="button" id="button-models" class="btn btn-default btn-block"><i class="fa fa-list"></i> Modelleri getir</button></div></div><div id="openrouter-model-list"></div></div>
        <div class="provider-panel provider-openai"><div class="info"><i class="fa fa-info-circle"></i><span><b>OpenAI bağlantısı.</b> Hesabınızda erişimi olan bir modeli seçin.</span></div><div class="form-grid"><label class="form-field"><span>OpenAI API anahtarı <em>Gerekli</em></span><div class="secret"><i class="fa fa-key"></i><input type="password" name="openai_key" value="{{ settings.module_ai_seo_openai_key }}" placeholder="sk-…"><button type="button" class="reveal-key" title="Anahtarı göster"><i class="fa fa-eye"></i></button></div></label><label class="form-field"><span>Model</span><input list="openai-models" type="text" name="openai_model" value="{{ settings.module_ai_seo_openai_model|default('gpt-4o-mini') }}" placeholder="Model seçin veya yazın"><datalist id="openai-models"><option value="gpt-4o-mini"><option value="gpt-4.1-mini"><option value="gpt-4.1"></datalist></label></div></div>
        <div class="provider-panel provider-gemini"><div class="info"><i class="fa fa-info-circle"></i><span><b>Google Gemini bağlantısı.</b> Google AI Studio API anahtarınızı kullanın.</span></div><div class="form-grid"><label class="form-field"><span>Gemini API anahtarı <em>Gerekli</em></span><div class="secret"><i class="fa fa-key"></i><input type="password" name="gemini_key" value="{{ settings.module_ai_seo_gemini_key }}" placeholder="AIza…"><button type="button" class="reveal-key" title="Anahtarı göster"><i class="fa fa-eye"></i></button></div></label><label class="form-field"><span>Model</span><input list="gemini-models" type="text" name="gemini_model" value="{{ settings.module_ai_seo_gemini_model|default('gemini-1.5-flash') }}" placeholder="Model seçin veya yazın"><datalist id="gemini-models"><option value="gemini-1.5-flash"><option value="gemini-1.5-pro"><option value="gemini-2.0-flash"></datalist></label></div></div>
      </section>
      <section class="settings-panel" id="tab-brand"><div class="panel-heading"><span class="panel-icon orange"><i class="fa fa-pencil"></i></span><div><h2>Marka ve içerik bağlamı</h2><p>AI’ın her ürün metninde uygulayacağı marka kurallarını yönetin.</p></div></div><div class="scan-box"><span class="scan-icon"><i class="fa fa-radar"></i></span><div><b>Mağazanızı tanımasını sağlayın</b><p>Ana sayfanızdaki başlık, açıklama ve dil bilgisinden SEO profili oluşturulur.</p></div><button type="button" class="btn btn-primary scan-trigger"><i class="fa fa-refresh"></i> Profili tara</button></div><div id="scan-profile" class="scan-result">{% if site_profile.title %}<i class="fa fa-check-circle"></i> <b>{{ site_profile.title }}</b> için SEO profili kayıtlı.{% else %}<i class="fa fa-info-circle"></i> Henüz profil oluşturulmadı. Marka notlarınızla başlayabilirsiniz.{% endif %}</div><div class="scan-report"><div><i class="fa fa-file-text-o"></i> <b>Son tarama raporu</b>{% if site_profile.logo %}<img id="scan-logo" src="{{ site_profile.logo }}" alt="Site logosu">{% else %}<img id="scan-logo" src="" alt="Site logosu" style="display:none">{% endif %}</div><textarea id="scan-report" readonly>{% if site_profile.title %}Tarama durumu: Başarılı
Site: {{ site_profile.site_url }}
Başlık: {{ site_profile.title }}
Açıklama: {{ site_profile.description }}
Dil: {{ site_profile.language }}
Tarama zamanı: {{ site_profile.scanned_at }}{% else %}Henüz tarama yapılmadı. “Profili tara” düğmesi mağazanızın ana sayfa SEO bilgisini burada gösterir.{% endif %}</textarea></div><section id="brand-analysis" class="brand-analysis"><div class="brand-analysis-head"><div><span><i class="fa fa-lightbulb-o"></i></span><div><h3>Marka tarama sonucu</h3><p>Yapay zekânın taranan sayfalardan çıkardığı marka ve SEO yorumu.</p></div></div><button type="button" class="btn btn-default btn-sm scan-trigger"><i class="fa fa-refresh"></i> Yeniden tara</button></div><div id="brand-analysis-response" class="brand-analysis-response">{% if brand_analysis.ai_response %}{{ brand_analysis.ai_response }}{% else %}Henüz yapay zekâ analizi oluşturulmadı. “Profili tara” ile mağaza sayfalarınızı tarayın.{% endif %}</div><div id="brand-analysis-facts" class="brand-analysis-facts">{% if brand_analysis.brand_identity %}<article><small>MARKA KİMLİĞİ</small><b>{{ brand_analysis.brand_identity }}</b></article>{% endif %}{% if brand_analysis.target_audience %}<article><small>HEDEF KİTLE</small><b>{{ brand_analysis.target_audience }}</b></article>{% endif %}{% if brand_analysis.tone %}<article><small>İLETİŞİM TONU</small><b>{{ brand_analysis.tone }}</b></article>{% endif %}</div><div id="brand-analysis-lists" class="brand-analysis-lists">{% if brand_analysis.value_propositions %}<div><b><i class="fa fa-star"></i> Güçlü yönler</b><ul>{% for item in brand_analysis.value_propositions %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}{% if brand_analysis.seo_opportunities %}<div><b><i class="fa fa-line-chart"></i> SEO fırsatları</b><ul>{% for item in brand_analysis.seo_opportunities %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}{% if brand_analysis.do_not_use %}<div><b><i class="fa fa-ban"></i> Kaçınılacak ifadeler</b><ul>{% for item in brand_analysis.do_not_use %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}</div></section><label class="form-field"><span>Marka notları ve yasaklı ifadeler</span><textarea name="brand_notes" rows="8" maxlength="3000" placeholder="Örnek: Samimi ve güven veren Türkçe kullan. Doğrulanamayan sağlık iddiaları yazma. Sertifikası olmayan ürünlerde organik kelimesini kullanma.">{{ settings.module_ai_seo_brand_notes }}</textarea><small>Bu notlar sadece AI üretim isteğine eklenir; müşteriler tarafından görüntülenmez.</small></label></section>
      <section class="settings-panel" id="tab-rules"><div class="panel-heading"><span class="panel-icon green"><i class="fa fa-sliders"></i></span><div><h2>Üretim kuralları</h2><p>Toplu üretimin kapsamını ve içerik tonunu belirleyin.</p></div></div><div class="form-grid three"><label class="form-field"><span>İçerik tonu</span><select name="generation_tone"><option value="professional" {% if settings.module_ai_seo_generation_tone == 'professional' %}selected{% endif %}>Profesyonel ve güven veren</option><option value="friendly" {% if settings.module_ai_seo_generation_tone == 'friendly' %}selected{% endif %}>Samimi ve sıcak</option><option value="premium" {% if settings.module_ai_seo_generation_tone == 'premium' %}selected{% endif %}>Premium ve seçkin</option><option value="concise" {% if settings.module_ai_seo_generation_tone == 'concise' %}selected{% endif %}>Kısa ve doğrudan</option></select></label><label class="form-field"><span>En fazla ürün</span><div class="number"><button type="button" class="limit-down" aria-label="Limiti azalt">−</button><input type="number" min="1" max="50" name="max_products" value="{{ settings.module_ai_seo_max_products|default('30') }}"><button type="button" class="limit-up" aria-label="Limiti artır">+</button></div><small>10–30 ürün önerilir.</small></label><label class="form-field"><span>Mağaza dili</span><select name="language_id">{% for language in languages %}<option value="{{ language.language_id }}" {% if language.language_id == settings.module_ai_seo_language_id %}selected{% endif %}>{{ language.name }}</option>{% endfor %}</select></label></div><div class="output"><div><span><i class="fa fa-magic"></i></span><b>Her seçili ürün için oluşturulur</b><small>Yalnızca SEO alanları güncellenir.</small></div><ul><li><i class="fa fa-header"></i> Meta başlığı</li><li><i class="fa fa-align-left"></i> Açıklama</li><li><i class="fa fa-tags"></i> Kelimeler</li><li><i class="fa fa-link"></i> SEO URL</li></ul></div></section>
      <input type="hidden" name="status" value="1"></div></section></form>
    <section class="ai-seo-steps"><div><span>NASIL ÇALIŞIR?</span><h2>Üç kolay adım</h2></div><ol><li><b>1</b><div><strong>Bağlantıyı kurun</strong><p>Sağlayıcı, API anahtarı ve modelinizi kaydedin.</p></div></li><li><b>2</b><div><strong>Mağazayı tanıtın</strong><p>Profil taraması ve marka notlarıyla bağlamı oluşturun.</p></div></li><li><b>3</b><div><strong>Ürünleri seçin</strong><p>Katalogdan ürünleri seçip AI SEO üretimini başlatın.</p></div></li></ol></section>
  </div>
    <footer class="ai-seo-footer"><span>AI SEO Asistanı</span><span>Geliştirici: <a href="https://github.com/efeytrl" target="_blank" rel="noopener noreferrer">efeytrl <i class="fa fa-github"></i></a></span></footer>
</main>
<style>
.ai-seo-page{background:#f5f6f8;min-height:calc(100vh - 50px);padding-bottom:30px}.ai-seo-header{margin-bottom:0;background:#fff;border-bottom:1px solid #e6e9ee}.ai-seo-header h1{font-size:23px}.ai-seo-header h1 i{color:#6f42c1;margin-right:6px}.ai-seo-intro{margin:22px 0 16px;padding:24px 28px;border-radius:4px;background:linear-gradient(125deg,#31205c,#6540ad);color:#fff;display:flex;gap:19px;align-items:center;box-shadow:0 8px 22px rgba(38,26,74,.16)}.intro-icon{flex:0 0 54px;width:54px;height:54px;border:1px solid rgba(255,255,255,.28);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;background:rgba(255,255,255,.1)}.intro-copy{max-width:650px}.intro-copy>span,.ai-seo-steps>div>span{font-size:10px;font-weight:700;letter-spacing:1px;color:#d7c9ff}.intro-copy h2{font-size:24px;margin:4px 0 7px}.intro-copy p{margin:0;line-height:1.55;color:#e8e0ff;font-size:13px}.intro-actions{margin-left:auto;display:flex;gap:10px;align-items:center;white-space:nowrap}.intro-actions .btn-success{background:#34a853;border-color:#34a853}.intro-actions .btn-link,.intro-actions .btn-link:hover{color:#fff}.ai-seo-status{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:16px}.ai-seo-status article{position:relative;display:flex;align-items:center;gap:13px;min-height:86px;background:#fff;border:1px solid #e4e8ee;border-radius:4px;padding:16px}.status-icon{width:42px;height:42px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:17px}.purple{color:#7045bf;background:#f0eafd}.blue{color:#2687c9;background:#e8f5fd}.green{color:#1d9b70;background:#e6f8f1}.ai-seo-status small{display:block;color:#82909f;font-size:10px;font-weight:700;letter-spacing:.5px}.ai-seo-status strong{display:block;font-size:16px;color:#334250;margin:2px 0}.ai-seo-status p{margin:0;color:#82909f;font-size:11px}.ai-seo-status p i{font-size:7px;color:#36aa70;margin-right:3px}.ai-seo-status .btn{position:absolute;right:15px;top:26p