<script type="text/javascript"><!--
function aiSeoMessage(type,text){$('#alert').html('<div class="alert alert-'+type+' alert-dismissible"><i class="fa fa-'+(type==='success'?'check-circle':'exclamation-circle')+'"></i> '+text+' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');window.scrollTo(0,0);}
function aiSeoUrl(method){var match=window.location.search.match(/[?&]user_token=([^&]+)/);return 'index.php?route=extension/module/ai_seo/'+method+'&user_token='+encodeURIComponent(match?decodeURIComponent(match[1]):'');}
function openAiSeoTab(tab){$('.settings-tab').removeClass('active');$('.settings-tab[data-tab="'+tab+'"]').addClass('active');$('.settings-panel').removeClass('active');$('#tab-'+tab).addClass('active');}
function updateProvider(){var provider=$('input[name=provider]:checked').val();$('.provider-panel').removeClass('active');$('.provider-'+provider).addClass('active');$('#provider-name').text(provider==='openai'?'OpenAI':provider==='gemini'?'Google Gemini':'OpenRouter');var hasKey=$('input[name='+provider+'_key]').val().length>0;$('#provider-state').html('<i class="fa fa-circle"></i> '+(hasKey?'Bağlantı için hazır':'API anahtarı bekleniyor'));}
function escapeHtml(text){return $('<div>').text(text||'').html();}
function parseResponse(raw){if(typeof raw==='object')return raw;try{return JSON.parse(raw);}catch(e){var start=raw.indexOf('{'),end=raw.lastIndexOf('}');if(start!==-1&&end>start){try{return JSON.parse(raw.substring(start,end+1));}catch(ignore){}}return null;}}
function scanStore(){var buttons=$('.scan-trigger'),original=buttons.first().html();buttons.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> Taranıyor…');$('#scan-report').val('Tarama başlatıldı… Ana sayfanın SEO bilgileri alınıyor.');$.ajax({url:aiSeoUrl('scan'),dataType:'json'}).done(function(json){if(json.error){aiSeoMessage('danger',json.error);return;}var profile=json.profile||{};var report='Tarama durumu: Başarılı\nSite: '+(profile.site_url||'')+'\nBaşlık: '+(profile.title||'')+'\nAçıklama: '+(profile.description||'')+'\nDil: '+(profile.language||'')+'\nTarama zamanı: '+(profile.scanned_at||'');$('#scan-report').val(report);$('#profile-state').text('Hazır');$('#scan-profile').html('<i class="fa fa-check-circle"></i> <b>'+escapeHtml(profile.title)+'</b> için SEO profili kayıtlı.');if(profile.logo){$('#scan-logo').attr('src',profile.logo).show();}else{$('#scan-logo').hide();}aiSeoMessage('success',json.success);}).fail(function(xhr){$('#scan-report').val('Tarama başarısız oldu. HTTP '+xhr.status+' döndü.');aiSeoMessage('danger','Tarama isteği tamamlanamadı (HTTP '+xhr.status+').');}).always(function(){buttons.prop('disabled',false);buttons.first().html(original);buttons.not(':first').html('<i class="fa fa-refresh"></i> Profili tara');});}
updateProvider();$('input[name=provider],input[name$=_key]').on('change input',updateProvider);$('.settings-tab').on('click',function(){openAiSeoTab($(this).data('tab'));});$('[data-open-tab]').on('click',function(){openAiSeoTab($(this).data('open-tab'));$('.ai-seo-workspace')[0].scrollIntoView({behavior:'smooth',block:'start'});});$('.reveal-key').on('click',function(){var input=$(this).siblings('input');input.attr('type',input.attr('type')==='password'?'text':'password');$(this).find('i').toggleClass('fa-eye fa-eye-slash');});$('.scan-trigger').on('click',scanStore);
$('#button-save').on('click',function(){var button=$(this),label=button.html();button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> Kaydediliyor…');$.ajax({url:aiSeoUrl('save'),type:'post',data:$('#form-ai-seo').serialize(),dataType:'text'}).done(function(raw){var json=parseResponse(raw);if(!json){aiSeoMessage('danger','Sunucudan geçersiz yanıt alındı. Sayfayı yenileyip tekrar deneyin.');return;}aiSeoMessage(json.error?'danger':'success',json.error||json.success||'Ayarlar kaydedildi.');}).fail(function(xhr){aiSeoMessage('danger','Ayarlar kaydedilemedi (HTTP '+xhr.status+').');}).always(function(){button.prop('disabled',false).html(label);});});
$('#button-models').on('click',function(){var button=$(this),label=button.html();button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> Yükleniyor…');$.ajax({url:aiSeoUrl('models'),dataType:'json'}).done(function(json){if(json.error){aiSeoMessage('danger',json.error);return;}var html='<div class="info"><i class="fa fa-check-circle"></i><span><b>Bir model seçin:</b> ';$.each(json.models,function(index,model){html+='<button type="button" class="btn btn-default btn-xs model-option" data-id="'+escapeHtml(model.id)+'">'+escapeHtml(model.name)+'</button> ';});$('#openrouter-model-list').html(html+'</span></div>');}).fail(function(xhr){aiSeoMessage('danger','Model listesi alınamadı (HTTP '+xhr.status+').');}).always(function(){button.prop('disabled',false).html(label);});});$(document).on('click','.model-option',function(){$('input[name=openrouter_model]').val($(this).data('id'));});
function changeLimit(change){var input=$('input[name=max_products]'),value=Math.max(1,Math.min(50,parseInt(input.val(),10)||30)+change);input.val(value);$('#limit-state').text(value);}$('input[name=max_products]').on('input',function(){$('#limit-state').text($(this).val()||1);});$('.limit-down').on('click',function(){changeLimit(-1);});$('.limit-up').on('click',function(){changeLimit(1);});
function renderBrandAnalysis(analysis){if(!analysis)return;$('#brand-analysis-response').text(analysis.ai_response||'Tarama tamamlandı; AI yorumu oluşturulamadı.');var facts='';$.each([{label:'MARKA KİMLİĞİ',value:analysis.brand_identity},{label:'HEDEF KİTLE',value:analysis.target_audience},{label:'İLETİŞİM TONU',value:analysis.tone},{label:'RAKİP TARAMASI',value:analysis.competitors_scanned?analysis.competitors_scanned+' açık URL tarandı':''}],function(index,item){if(item.value)facts+='<article><small>'+item.label+'</small><b>'+escapeHtml(item.value)+'</b></article>';});$('#brand-analysis-facts').html(facts);var groups=[{title:'Güçlü yönler',icon:'fa-star',items:analysis.value_propositions},{title:'SEO fırsatları',icon:'fa-line-chart',items:analysis.seo_opportunities},{title:'Arama niyeti sinyalleri',icon:'fa-crosshairs',items:analysis.search_intent},{title:'Rakiplerden ayrışma fırsatları',icon:'fa-binoculars',items:analysis.competitor_gaps},{title:'Kaçınılacak ifadeler',icon:'fa-ban',items:analysis.do_not_use}],lists='';$.each(groups,function(index,group){if(group.items&&group.items.length){lists+='<div><b><i class="fa '+group.icon+'"></i> '+group.title+'</b><ul>';$.each(group.items,function(_,item){lists+='<li>'+escapeHtml(item)+'</li>';});lists+='</ul></div>';}});$('#brand-analysis-lists').html(lists);}
$(document).ajaxSuccess(function(event,xhr,settings,data){if(settings.url&&settings.url.indexOf('extension/module/ai_seo/scan')!==-1&&data&&data.analysis)renderBrandAnalysis(data.analysis);});
$(function(){var openAiInput=$('input[name=openai_model]');if(openAiInput.length&&!$('#button-openai-models').length){openAiInput.closest('label').append('<button type="button" id="button-openai-models" class="btn btn-default btn-sm ai-seo-model-button"><i class="fa fa-refresh"></i> OpenAI modellerini getir</button><small class="ai-seo-api-note">OpenAI API erişimi, güvenli API anahtarıyla yapılır.</small>');}$('#button-openai-models').on('click',function(){var button=$(this),label=button.html();button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> Yükleniyor…');$.ajax({url:aiSeoUrl('models')+'&provider=openai',dataType:'json'}).done(function(json){if(json.error){aiSeoMessage('danger',json.error);return;}var options='';$.each(json.models,function(_,model){options+='<button type="button" class="btn btn-default btn-xs openai-model-option" data-id="'+escapeHtml(model.id)+'">'+escapeHtml(model.name)+'</button> ';});$('#openrouter-model-list').html('<div class="info"><i class="fa fa-check-circle"></i><span><b>OpenAI modelini seçin:</b> '+options+'</span></div>');}).fail(function(xhr){aiSeoMessage('danger','OpenAI modelleri alınamadı (HTTP '+xhr.status+').');}).always(function(){button.prop('disabled',false).html(label);});});$(document).on('click','.openai-model-option',function(){$('input[name=openai_model]').val($(this).data('id'));});});
$(function(){var history={total:{{ history_summary.total|default(0) }},score:{{ history_summary.average_score|default(0) }},tokens:{{ history_summary.tokens|default(0) }},cost:'{{ history_summary.cost|default(0)|number_format(4, '.', ',') }}'};if(!$('.ai-seo-insights').length){$('.ai-seo-status').after('<section class="ai-seo-insights"><article><small>TOPLAM ÜRETİM</small><b>'+history.total+'</b><span>kayıtlı ürün işlemi</span></article><article><small>ORTALAMA SEO SKORU</small><b>'+history.score+'<em>/100</em></b><span>sonuçların kalite ortalaması</span></article><article><small>TAHMİNİ TOKEN</small><b>'+history.tokens+'</b><span>sağlayıcının döndürdüğü kullanım</span></article><article><small>BİLDİRİLEN MALİYET</small><b>$'+history.cost+'</b><span>sağlayıcı yanıtında varsa</span></article></section>');}});
$(function(){$('#button-openai-models').html('<i class="fa fa-plug"></i> Bağlantıyı doğrula ve modelleri getir');if(!$('#openai-account-link').length&&$('input[name=openai_key]').length){$('input[name=openai_key]').closest('.form-field').append('<div class="ai-seo-account-connect"><a id="openai-account-link" href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer"><i class="fa fa-external-link"></i> OpenAI hesabını aç ve API anahtarı oluştur</a><p>ChatGPT hesabınızla giriş yaptıktan sonra Platform’dan oluşturduğunuz anahtarı buraya yapıştırın; ardından ayarları kaydedip bağlantıyı doğrulayın.</p></div>');}});
$(function(){var competitorValue='{{ settings.module_ai_seo_competitor_urls|default('')|e('js') }}';var note=$('textarea[name=brand_notes]');if(note.length&&!$('textarea[name=competitor_urls]').length){note.closest('.form-field').before('<label class="form-field ai-seo-competitors"><span><i class="fa fa-binoculars"></i> Rakip URL’leri ve arama niyeti</span><textarea name="competitor_urls" rows="3" maxlength="1800" placeholder="En fazla 3 herkese açık URL; virgül veya yeni satırla ayırın."></textarea><small>Rakip sayfaların başlık, açıklama ve içerik sinyalleri okunur. Google sıralaması veya erişilemeyen arama sonuçları hakkında iddia üretmez.</small></label>');$('textarea[name=competitor_urls]').val(competitorValue);$('.ai-seo-competitors').css({padding:'14px',background:'#f8f9fd',border:'1px solid #e1e7f0','border-radius':'10px'});}});
$(function(){var updateButton=$('#button-update'),availableRelease=null;function setUpdateButton(version){updateButton.prop('disabled',false).html('<i class="fa fa-cloud-download"></i><span>Güncellemeleri denetle</span><em>v'+escapeHtml(version||updateButton.data('current-version'))+'</em>');}function closeUpdateModal(){ $('#ai-seo-update-modal').removeClass('open'); }function openUpdateModal(release){var modal=$('#ai-seo-update-modal');if(!modal.length){$('body').append('<div id="ai-seo-update-modal" class="ai-seo-update-modal" role="dialog" aria-modal="true"><div class="ai-seo-update-card"><div class="ai-seo-update-head"><span><i class="fa fa-cloud-download"></i></span><div><strong>Yeni sürüm hazır</strong><small>Resmî GitHub yayınından güvenli güncelleme</small></div><button type="button" class="ai-seo-update-close" aria-label="Kapat" title="Kapat">&times;</button></div><div class="ai-seo-update-body"></div><div class="ai-seo-update-actions"><button type="button" class="btn btn-primary" id="ai-seo-install-update"><i class="fa fa-download"></i> Şimdi güncelle</button></div></div></div>');modal=$('#ai-seo-update-modal');$(document).on('click','.ai-seo-update-close',closeUpdateModal);modal.on('click',function(event){if(event.target===this)closeUpdateModal();});}var notes=escapeHtml(release.notes||'Bu sürüm için yayın notu eklenmedi.');modal.find('.ai-seo-update-body').html('<div class="ai-seo-update-version"><div><span>Yüklü sürüm</span><b>v'+escapeHtml(release.current_version)+'</b></div><i class="fa fa-arrow-right" style="color:#9c85ce"></i><div><span>Yeni sürüm</span><b>v'+escapeHtml(release.latest_version)+'</b></div></div><p>Güncelleme paketi GitHub Releases üzerinden indirilir, yalnızca AI SEO Assistant OCMOD paketi kabul edilir ve OpenCart değişiklikleri otomatik yenilenir.</p><div class="ai-seo-update-notes">'+notes+'</div>');modal.addClass('open');}function checkUpdate(manual){if(!updateButton.length)return;var label=updateButton.html();if(manual)updateButton.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i><span>Denetleniyor…</span>');$.ajax({url:aiSeoUrl('updateStatus'),dataType:'json',cache:false}).done(function(json){if(json.error){if(manual)aiSeoMessage('danger',json.error);return;}if(json.update_available){availableRelease=json;updateButton.prop('disabled',false).html('<i class="fa fa-download"></i><span>v'+escapeHtml(json.latest_version)+' sürümüne güncelle</span>');if(manual)openUpdateModal(json);}else if(manual)aiSeoMessage('success','AI SEO Asistanı güncel. Yüklü sürüm: v'+escapeHtml(json.current_version)+'.');}).fail(function(xhr){if(manual)aiSeoMessage('danger','Güncelleme denetimi tamamlanamadı (HTTP '+xhr.status+').');}).always(function(){if(!availableRelease)setUpdateButton((availableRelease&&availableRelease.latest_version)||updateButton.data('current-version'));});}updateButton.on('click',function(){if(availableRelease)openUpdateModal(availableRelease);else checkUpdate(true);});$(document).on('click','#ai-seo-install-update',function(){var button=$(this),label=button.html();button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> İndiriliyor ve yükleniyor…');$.ajax({url:aiSeoUrl('update'),type:'post',dataType:'text'}).done(function(raw){var json=parseResponse(raw);if(!json||json.error){aiSeoMessage('danger',(json&&json.error)||'Güncelleme yanıtı geçersiz.');button.prop('disabled',false).html(label);return;}closeUpdateModal();aiSeoMessage('success',json.success);setTimeout(function(){window.location.reload();},1800);}).fail(function(xhr){aiSeoMessage('danger','Güncelleme tamamlanamadı (HTTP '+xhr.status+').');button.prop('disabled',false).html(label);});});checkUpdate(false);});
$(function(){var tools='<a href="{{ history_url }}" class="btn btn-default"><i class="fa fa-history"></i> İşlem geçmişi</a> <a href="{{ categories_url }}" class="btn btn-default"><i class="fa fa-sitemap"></i> Kategoriler</a> ';$('.ai-seo-header .pull-right').prepend(tools);var audit='<button type="button" id="button-category-audit" class="btn btn-default"><i class="fa fa-search"></i> Kategorileri tara</button> ';$('.ai-seo-header .pull-right').prepend(audit);function auditModal(html){var box=$('#ai-seo-audit-modal');if(!box.length){$('body').append('<div id="ai-seo-audit-modal" style="display:none;position:fixed;z-index:10060;inset:0;padding:18px;background:rgba(17,26,43,.66);overflow:auto"><div style="max-width:720px;margin:5vh auto;background:#fff;border-radius:16px;box-shadow:0 24px 75px rgba(0,0,0,.35);overflow:hidden"><div style="padding:20px 24px;background:linear-gradient(135deg,#f7f3ff,#f5f9ff);font-weight:800;font-size:18px;color:#34465f"><i class="fa fa-search" style="color:#7654bb"></i> Kategori SEO taraması <button type="button" class="close-ai-audit" style="float:right;border:0;background:transparent;font-size:24px;color:#718096">&times;</button></div><div class="ai-audit-content" style="padding:22px 24px;color:#516277"></div></div></div>');box=$('#ai-seo-audit-modal');$(document).on('click','.close-ai-audit',function(){box.hide();});}box.find('.ai-audit-content').html(html);box.show();}$('#button-category-audit').on('click',function(){var button=$(this),label=button.html();button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> Taranıyor…');$.ajax({url:aiSeoUrl('categoryAudit'),dataType:'json'}).done(function(json){if(json.error){aiSeoMessage('danger',json.error);return;}var html='<p style="margin-top:0">Toplam <b>'+json.total+'</b> aktif kategori tarandı. Ortalama kalite skoru <b>'+json.average_score+'/100</b>.</p>';if(json.issues&&json.issues.length){html+='<div style="max-height:430px;overflow:auto;border:1px solid #e3e9ef;border-radius:10px">';$.each(json.issues,function(_,item){html+='<div style="padding:13px 14px;border-bottom:1px solid #edf1f5"><b style="color:#34465f">'+escapeHtml(item.name)+'</b> <span style="float:right;padding:3px 8px;border-radius:99px;background:#f1ebfb;color:#704db2;font-size:11px;font-weight:800">'+item.score+'/100</span><small style="display:block;margin-top:6px;color:#8290a0">'+escapeHtml((item.notes||[]).join(' • '))+'</small></div>';});html+='</div><p style="margin:14px 0 0"><a class="btn btn-primary" href="{{ categories_url }}"><i class="fa fa-magic"></i> Kategorilere git ve üret</a></p>';}else html+='<div class="alert alert-success">Harika, tüm aktif kategoriler temel kalite kontrollerini geçti.</div>';auditModal(html);}).fail(function(xhr){aiSeoMessage('danger','Kategori taraması tamamlanamadı (HTTP '+xhr.status+').');}).always(function(){button.prop('disabled',false).html(label);});});});
