{{ header }}{{ column_left }}
<style>
.ai-history{min-height:calc(100vh - 120px);padding-bottom:28px;background:linear-gradient(135deg,#f5f7fb,#eef3f9);color:#26364a}.ai-history .container-fluid{max-width:1400px}.ai-history .page-header{margin:0;background:transparent;border:0}.ai-history .page-header .container-fluid{padding-top:18px}.ai-history .page-header h1{font-size:23px}.ai-history .page-header h1 i{margin-right:6px;color:#6f42c1}.ai-history .breadcrumb{background:transparent}.ai-history-shell{max-width:1400px;margin:0 auto;padding-top:22px}.ai-history-hero{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:22px;padding:26px 28px;border-radius:18px;background:linear-gradient(135deg,#263a67,#5e3c97);box-shadow:0 18px 40px rgba(36,54,92,.2);color:#fff}.ai-history-hero h2{margin:0 0 6px;font-size:25px;font-weight:800}.ai-history-hero p{margin:0;color:#dfe7ff}.ai-history-hero .btn{border-radius:9px;border:0;font-weight:700}.ai-history-hero .btn-default{color:#34455a}.ai-history-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}.ai-history-stats article,.ai-history-panel{background:#fff;border:1px solid #e4eaf1;border-radius:14px;box-shadow:0 8px 22px rgba(42,63,90,.06)}.ai-history-stats article{padding:17px 19px}.ai-history-stats small{display:block;color:#748398;font-size:10px;font-weight:800;letter-spacing:.7px}.ai-history-stats b{display:block;margin-top:7px;color:#2e4264;font-size:25px}.ai-history-stats span{color:#8a98a8;font-size:12px}.ai-history-panel{margin-bottom:20px;overflow:hidden}.ai-history-panel h2{margin:0;padding:18px 20px;border-bottom:1px solid #e8edf3;color:#34465e;font-size:16px;font-weight:800}.ai-history-panel h2 i{margin-right:7px;color:#7654bb}.ai-history-table-wrap{overflow-x:auto}.ai-history table{min-width:800px;margin:0}.ai-history th{border-top:0!important;background:#f7f9fc!important;color:#738297!important;font-size:10px;letter-spacing:.55px}.ai-history td,.ai-history th{padding:13px 16px!important;vertical-align:middle!important}.ai-history td{color:#506176;font-size:12px}.ai-history-name{font-weight:700;color:#34465e}.ai-history-status,.ai-history-score{display:inline-block;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:800}.ai-history-status{background:#e9f7ef;color:#23804d}.ai-history-score{background:#f0ebfb;color:#6a45ad}.ai-history-empty{padding:34px 20px;color:#8a98a8;text-align:center}.ai-history-empty i{display:block;margin-bottom:8px;color:#a88cdb;font-size:25px}@media(max-width:800px){.ai-history .page-header .container-fluid{padding-top:14px}.ai-history-shell{padding-top:16px}.ai-history-hero{align-items:flex-start;flex-direction:column;padding:22px}.ai-history-stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:440px){.ai-history-stats{grid-template-columns:1fr}.ai-history-hero h2{font-size:21px}}
</style>
<main class="ai-history" id="content"><div class="page-header ai-seo-header"><div class="container-fluid"><h1><i class="fa fa-history"></i> İşlem geçmişi</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div><div class="container-fluid ai-history-shell">
  <section class="ai-history-hero"><div><h2><i class="fa fa-history"></i> Tüm AI işlemleriniz tek yerde</h2><p>Ürün ve kategori üretimlerinin model, kalite ve kullanım kaydı.</p></div><div><a href="{{ products_url }}" class="btn btn-default"><i class="fa fa-cube"></i> Ürünler</a> <a href="{{ categories_url }}" class="btn btn-default"><i class="fa fa-sitemap"></i> Kategoriler</a> <a href="{{ assistant_url }}" class="btn btn-primary"><i class="fa fa-magic"></i> Asistana dön</a></div></section>
  <section class="ai-history-stats"><article><small>TOPLAM ÜRÜN İŞLEMİ</small><b>{{ summary.total }}</b><span>tamamlanan kayıt</span></article><article><small>ORTALAMA SEO SKORU</small><b>{{ summary.average_score }}/100</b><span>ürün üretim ortalaması</span></article><article><small>KULLANIM BİLDİRİMİ</small><b>{{ summary.tokens }}</b><span>toplam token</span></article><article><small>BİLDİRİLEN MALİYET</small><b>${{ summary.cost|number_format(4, '.', ',') }}</b><span>sağlayıcı verisi varsa</span></article></section>
  <section class="ai-history-panel"><h2><i class="fa fa-cube"></i> Ürün üretimleri</h2>{% if product_history %}<div class="ai-history-table-wrap"><table class="table table-hover"><thead><tr><th>ÜRÜN</th><th>DURUM</th><th>SAĞLAYICI / MODEL</th><th>SKOR</th><th>TOKEN</th><th>MALİYET</th><th>TARİH</th><th></th></tr></thead><tbody>{% for item in product_history %}<tr><td><span class="ai-history-name">{{ item.product_name }}</span></td><td><span class="ai-history-status">{{ item.status }}</span></td><td>{{ item.provider }}<br><small>{{ item.model }}</small></td><td><span class="ai-history-score">{{ item.seo_score }}/100</span></td><td>{{ item.input_tokens + item.output_tokens }}</td><td>${{ item.estimated_cost|number_format(4, '.', ',') }}</td><td>{{ item.created_at }}</td><td>{% if item.before_data %}<button type="button" class="btn btn-default btn-xs undo-history" data-id="{{ item.history_id }}"><i class="fa fa-undo"></i> Geri al</button>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="ai-history-empty"><i class="fa fa-inbox"></i>Henüz ürün üretim kaydı yok.</div>{% endif %}</section>
  <section class="ai-history-panel"><h2><i class="fa fa-sitemap"></i> Kategori üretimleri</h2>{% if category_history %}<div class="ai-history-table-wrap"><table class="table table-hover"><thead><tr><th>KATEGORİ</th><th>DURUM</th><th>SAĞLAYICI / MODEL</th><th>SKOR</th><th>TOKEN</th><th>MALİYET</th><th>TARİH</th></tr></thead><tbody>{% for item in category_history %}<tr><td><span class="ai-history-name">{{ item.category_name }}</span></td><td><span class="ai-history-status">{{ item.status }}</span></td><td>{{ item.provider }}<br><small>{{ item.model }}</small></td><td><span class="ai-history-score">{{ item.seo_score }}/100</span></td><td>{{ item.input_tokens + item.output_tokens }}</td><td>${{ item.estimated_cost|number_format(4, '.', ',') }}</td><td>{{ item.created_at }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="ai-history-empty"><i class="fa fa-inbox"></i>Henüz kategori üretim kaydı yok.</div>{% endif %}</section>
</div></main>
<script type="text/javascript"><!--
$(document).on('click','.undo-history',function(){var button=$(this);if(!confirm('Bu işlem üründeki SEO alanlarını bu kayıttan önceki hâline geri döndürür. Devam edilsin mi?'))return;button.prop('disabled',true);$.post('index.php?route=extension/module/ai_seo/undo&user_token='+encodeURIComponent((location.search.match(/[?&]user_token=([^&]+)/)||[])[1]||''),{history_id:button.data('id')},function(json){if(json.error){alert(json.error);button.prop('disabled',false);}else{location.reload();}},'json').fail(function(){alert('Geri alma isteği tamamlanamadı.');button.prop('disabled',false);});});
//--></script>
