  <file path="admin/view/template/catalog/product_list.twig">
    <operation>
      <search><![CDATA[<div class="pull-right">]]></search>
      <add position="after"><![CDATA[
<button type="button" id="button-ai-seo" class="btn btn-success" data-toggle="tooltip" title="Seçilen ürünlere AI SEO üret"><i class="fa fa-magic"></i> AI SEO Üret</button>
<style type="text/css">.ai-seo-modal{display:none;position:fixed;z-index:10050;inset:0;background:rgba(24,34,47,.58);padding:18px;overflow:auto}.ai-seo-modal.open{display:flex;align-items:center;justify-content:center}.ai-seo-modal-card{position:relative;width:100%;max-width:560px;max-height:calc(100vh - 36px);overflow:auto;background:#fff;border-radius:6px;box-shadow:0 18px 55px rgba(0,0,0,.28)}.ai-seo-modal-head{padding:18px 48px 15px 20px;border-bottom:1px solid #e3e8ed;color:#3b4c5d;font-size:17px;font-weight:700}.ai-seo-modal-head i{color:#6f42c1;margin-right:6px}.ai-seo-modal-close{position:absolute;right:12px;top:10px;border:0;background:transparent;color:#84919d;font-size:27px;line-height:1}.ai-seo-modal-body{padding:20px;color:#647585;font-size:13px;line-height:1.55}.ai-seo-modal-actions{display:flex;justify-content:flex-end;gap:8px;padding:14px 20px;border-top:1px solid #e5eaef}.ai-seo-progress>div:first-child{display:flex;justify-content:space-between;color:#46596a}.ai-seo-progress-track{height:10px;margin:12px 0;border-radius:10px;background:#e8edf1;overflow:hidden}.ai-seo-progress-track i{display:block;height:100%;border-radius:10px;background:linear-gradient(90deg,#6d43b4,#9b72e6);transition:width .25s}.ai-seo-results{max-height:250px;overflow:auto;border:1px solid #e5ebf0;border-radius:4px}.ai-seo-results>div{display:flex;justify-content:space-between;gap:12px;padding:9px 10px;border-top:1px solid #edf1f4;font-size:12px}.ai-seo-results>div:first-child{border-top:0}.ai-seo-results .fa-check-circle{color:#2fa66a}.ai-seo-results .fa-times-circle{color:#cf5b52}.ai-seo-results span{white-space:nowrap;color:#6a45ae;font-weight:700}.ai-seo-results .error{display:block;color:#a64e49}.ai-seo-result-summary{margin-bottom:13px}.ai-seo-provider-options{display:grid;gap:8px;margin-top:14px}.ai-seo-provider-options input{position:absolute;opacity:0}.ai-seo-provider-options label span{display:block;padding:10px 12px;border:1px solid #dce4eb;border-radius:4px;cursor:pointer}.ai-seo-provider-options input:checked+span{border-color:#6d43b4;background:#f8f5ff;box-shadow:0 0 0 1px #6d43b4}.ai-seo-provider-options b,.ai-seo-provider-options small{display:block}.ai-seo-provider-options b{color:#46596a;font-size:13px}.ai-seo-provider-options small{margin-top:2px;color:#84929d;font-size:11px}@media(max-width:560px){.ai-seo-modal{padding:10px}.ai-seo-modal-card{max-height:calc(100vh - 20px)}.ai-seo-modal-actions{flex-wrap:wrap}.ai-seo-results>div{align-items:flex-start;flex-direction:column;gap:2px}}</style>
<style type="text/css">.ai-seo-modal{backdrop-filter:blur(8px);background:rgba(16,24,39,.68)}.ai-seo-modal-card{max-width:620px;border:1px solid rgba(255,255,255,.58);border-radius:16px;box-shadow:0 28px 80px rgba(4,12,24,.42);animation:aiSeoModalIn .2s ease-out}.ai-seo-modal-head{padding:22px 58px 18px 24px;background:linear-gradient(135deg,#faf8ff,#f5f9ff);border-bottom:1px solid #e7e9f2;color:#2b3850;font-size:18px}.ai-seo-modal-head:before{content:'AI SEO';display:block;margin-bottom:4px;color:#7552b8;font-size:9px;font-weight:800;letter-spacing:1.2px}.ai-seo-modal-close{right:17px;top:15px;width:32px;height:32px;border-radius:50%;background:#fff;color:#7b8794;font-size:24px;box-shadow:0 2px 8px rgba(0,0,0,.08)}.ai-seo-modal-body{padding:24px;color:#5c6d7d;font-size:13px}.ai-seo-modal-actions{padding:16px 24px;background:#fafbfd;border-top:1px solid #e9edf1}.ai-seo-modal-actions .btn{border-radius:7px;padding:8px 14px;font-weight:700}.ai-seo-modal-actions .btn-primary{border-color:#6544a8;background:linear-gradient(135deg,#6040a5,#835fd0);box-shadow:0 5px 12px rgba(100,68,168,.22)}.ai-seo-progress>div:first-child{font-size:14px}.ai-seo-progress-track{height:12px;margin:15px 0;background:#e7ebf1;box-shadow:inset 0 1px 2px rgba(30,50,70,.08)}.ai-seo-progress-track i{background:linear-gradient(90deg,#6c44b4,#a579f0);box-shadow:0 2px 7px rgba(111,69,187,.35)}.ai-seo-progress p{margin:0;padding:11px 12px;border-radius:7px;background:#f7f8fc;color:#708090;font-size:12px}.ai-seo-provider-options{gap:10px}.ai-seo-provider-options label span{padding:13px 15px;border-radius:8px;transition:border-color .15s,background .15s,transform .15s}.ai-seo-provider-options label:hover span{transform:translateY(-1px);border-color:#bba9dd}.ai-seo-provider-options input:checked+span{border-color:#7753bc;background:linear-gradient(135deg,#fbf9ff,#f4efff);box-shadow:0 0 0 3px rgba(119,83,188,.12)}.ai-seo-provider-options b:before{content:'●';margin-right:7px;color:#8c65d6;font-size:10px}.ai-seo-results{border-radius:8px;border-color:#e3e8ef}.ai-seo-results>div{padding:11px 13px}.ai-seo-results span{padding:3px 7px;border-radius:10px;background:#f0ebfb;color:#6946ae;font-size:10px}@keyframes aiSeoModalIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}</style>
<script type="text/javascript"><!--
var aiSeoQueueKey='ai_seo_product_queue';
function aiSeoEscape(text){return $('<div>').text(text||'').html();}
function aiSeoModal(title,body,actions){var modal=$('#ai-seo-modal');if(!modal.length){$('body').append('<div id="ai-seo-modal" class="ai-seo-modal"><div class="ai-seo-modal-card"><button type="button" class="ai-seo-modal-close" aria-label="Kapat">&times;</button><div class="ai-seo-modal-head"></div><div class="ai-seo-modal-body"></div><div class="ai-seo-modal-actions"></div></div></div>');modal=$('#ai-seo-modal');$(document).on('click','.ai-seo-modal-close',function(){modal.removeClass('open');});}modal.find('.ai-seo-modal-head').html(title);modal.find('.ai-seo-modal-body').html(body);modal.find('.ai-seo-modal-actions').html(actions||'');modal.addClass('open');}
function aiSeoSelected(){var selected=$('input[name^="selected"]:checked').map(function(){return this.value;}).get();return $.grep(selected,function(value,index){return $.inArray(value,selected)===index;});}
function aiSeoSaveQueue(queue){sessionStorage.setItem(aiSeoQueueKey,JSON.stringify(queue));}
function aiSeoRenderProgress(queue){var completed=queue.current,total=queue.products.length,percent=total?Math.round(completed*100/total):0;var current=queue.results.length?queue.results[queue.results.length-1]:null;var message=current?(current.error?'Son işlem: '+aiSeoEscape(current.name||('Ürün #'+current.product_id))+' — hata':'Son işlem: '+aiSeoEscape(current.name)+' — SEO skoru '+(current.seo_score||0)):'İşlem hazırlanıyor…';aiSeoModal('<i class="fa fa-magic"></i> AI SEO üretimi','<div class="ai-seo-progress"><div><b>'+completed+' / '+total+' ürün işlendi</b><span>'+percent+'%</span></div><div class="ai-seo-progress-track"><i style="width:'+percent+'%"></i></div><p>'+message+'</p></div>','<button type="button" class="btn btn-default" id="ai-seo-pause">Durdur ve sonra devam et</button>');}
function aiSeoFinish(queue){var success=0,errors=0,html='<div class="ai-seo-results">';$.each(queue.results,function(_,result){if(result.error){errors++;html+='<div class="error"><i class="fa fa-times-circle"></i> '+aiSeoEscape(result.name||('Ürün #'+result.product_id))+': '+aiSeoEscape(result.error)+'</div>';}else{success++;html+='<div><i class="fa fa-check-circle"></i> '+aiSeoEscape(result.name)+' <span>SEO skoru: '+(result.seo_score||0)+'/100</span></div>';}});html+='</div>';aiSeoModal('<i class="fa fa-check-circle"></i> Üretim tamamlandı','<p class="ai-seo-result-summary"><b>'+success+'</b> ürün tamamlandı'+(errors?', <b>'+errors+'</b> ürün hata verdi':'')+'.</p>'+html,'<button type="button" class="btn btn-primary ai-seo-modal-close">Kapat</button>');sessionStorage.removeItem(aiSeoQueueKey);$('#button-ai-seo').prop('disabled',false).html('<i class="fa fa-magic"></i> AI SEO Üret');}
function aiSeoRun(queue){if(queue.paused)return;aiSeoRenderProgress(queue);if(queue.current>=queue.products.length){aiSeoFinish(queue);return;}var token=(window.location.search.match(/[?&]user_token=([^&]+)/)||[])[1];if(!token){queue.results.push({product_id:queue.products[queue.current],error:'Yönetici oturum anahtarı bulunamadı.'});queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);return;}$.ajax({url:'index.php?route=extension/module/ai_seo/generate&user_token='+encodeURIComponent(decodeURIComponent(token)),type:'post',dataType:'json',timeout:180000,data:{product_id:[queue.products[queue.current]]}}).done(function(json){var result=json.error?{product_id:queue.products[queue.current],error:json.error}:(json.results&&json.results[0]?json.results[0]:{product_id:queue.products[queue.current],error:'Geçersiz sunucu yanıtı.'});queue.results.push(result);queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);}).fail(function(xhr){queue.results.push({product_id:queue.products[queue.current],error:'İstek tamamlanamadı (HTTP '+xhr.status+').'});queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);});}
$(document).on('click','#button-ai-seo',function(event){event.preventDefault();var selected=aiSeoSelected(),stored=sessionStorage.getItem(aiSeoQueueKey),queue=stored?JSON.parse(stored):null;if(!selected.length&&queue&&queue.current<queue.products.length){aiSeoModal('<i class="fa fa-history"></i> Yarım kalan işlem','<p><b>'+queue.current+'</b> / '+queue.products.length+' ürün işlendi. Kaldığınız yerden devam etmek ister misiniz?</p>','<button type="button" class="btn btn-default ai-seo-modal-close">Vazgeç</button><button type="button" class="btn btn-primary" id="ai-seo-resume">Devam et</button>');return false;}if(!selected.length){aiSeoModal('<i class="fa fa-exclamation-circle"></i> Ürün seçin','<p>SEO üretimi için listeden en az bir ürün seçmelisiniz.</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');return false;}aiSeoModal('<i class="fa fa-magic"></i> SEO üretimini başlat','<p><b>'+selected.length+'</b> ürün için meta başlığı, açıklama, anahtar kelime, SEO URL ve uygun kategoriler üretilecek.</p><p class="text-muted">İşlem ilerlemesini bu pencereden izleyebilir; durdurup aynı tarayıcıda daha sonra devam edebilirsiniz.</p>','<button type="button" class="btn btn-default ai-seo-modal-close">Vazgeç</button><button type="button" class="btn btn-primary" id="ai-seo-start">Üretimi başlat</button>');$(document).off('click.aiSeoStart','#ai-seo-start').on('click.aiSeoStart','#ai-seo-start',function(){queue={products:selected,current:0,results:[],paused:false};aiSeoSaveQueue(queue);$('#button-ai-seo').prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> SEO üretiliyor…');aiSeoRun(queue);});return false;});
$(document).on('click','#ai-seo-pause',function(){var queue=JSON.parse(sessionStorage.getItem(aiSeoQueueKey)||'null');if(queue){queue.paused=true;aiSeoSaveQueue(queue);}$('#ai-seo-modal').removeClass('open');$('#button-ai-seo').prop('disabled',false).html('<i class="fa fa-history"></i> SEO işlemine devam et');});$(document).on('click','#ai-seo-resume',function(){var queue=JSON.parse(sessionStorage.getItem(aiSeoQueueKey)||'null');if(queue){queue.paused=false;aiSeoSaveQueue(queue);$('#button-ai-seo').prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> SEO üretiliyor…');aiSeoRun(queue);}});
function aiSeoRun(queue){if(queue.paused)return;aiSeoRenderProgress(queue);if(queue.current>=queue.products.length){aiSeoFinish(queue);return;}var token=(window.location.search.match(/[?&]user_token=([^&]+)/)||[])[1];if(!token){queue.results.push({product_id:queue.products[queue.current],error:'Yönetici oturum anahtarı bulunamadı.'});queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);return;}$.ajax({url:'index.php?route=extension/module/ai_seo/generate&user_token='+encodeURIComponent(decodeURIComponent(token)),type:'post',dataType:'json',timeout:180000,data:{product_id:[queue.products[queue.current]],provider:queue.provider||''}}).done(function(json){var result=json.error?{product_id:queue.products[queue.current],error:json.error}:(json.results&&json.results[0]?json.results[0]:{product_id:queue.products[queue.current],error:'Geçersiz sunucu yanıtı.'});queue.results.push(result);queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);}).fail(function(xhr){queue.results.push({product_id:queue.products[queue.current],error:'İstek tamamlanamadı (HTTP '+xhr.status+').'});queue.current++;aiSeoSaveQueue(queue);aiSeoRun(queue);});}
function aiSeoShowProviderModal(selected,token){$.ajax({url:'index.php?route=extension/module/ai_seo/providers&user_token='+encodeURIComponent(token),dataType:'json'}).done(function(json){if(json.error){aiSeoModal('<i class="fa fa-exclamation-circle"></i> Sağlayıcılar alınamadı','<p>'+aiSeoEscape(json.error)+'</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');return;}if(!json.providers||!json.providers.length){aiSeoModal('<i class="fa fa-plug"></i> Sağlayıcı bulunamadı','<p>Üretimden önce en az bir AI sağlayıcısı için API anahtarı kaydedin.</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');return;}var options='<div class="ai-seo-provider-options">';$.each(json.providers,function(index,provider){options+='<label><input type="radio" name="ai_seo_queue_provider" value="'+provider.id+'" '+(provider.selected?'checked':'')+'><span><b>'+aiSeoEscape(provider.label)+'</b><small>'+aiSeoEscape(provider.model)+'</small></span></label>';});options+='</div>';aiSeoModal('<i class="fa fa-magic"></i> SEO üretimini başlat','<p><b>'+selected.length+'</b> ürün işlenecek. Bu üretimde kullanılacak sağlayıcı ve modeli seçin.</p>'+options,'<button type="button" class="btn btn-default ai-seo-modal-close">Vazgeç</button><button type="button" class="btn btn-primary" id="ai-seo-start-with-provider">Üretimi başlat</button>');$(document).off('click.aiSeoStartProvider','#ai-seo-start-with-provider').on('click.aiSeoStartProvider','#ai-seo-start-with-provider',function(){var provider=$('input[name=ai_seo_queue_provider]:checked').val();var queue={products:selected,current:0,results:[],paused:false,provider:provider};aiSeoSaveQueue(queue);$('#button-ai-seo').prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> SEO üretiliyor…');aiSeoRun(queue);});}).fail(function(xhr){aiSeoModal('<i class="fa fa-exclamation-circle"></i> Bağlantı hatası','<p>Sağlayıcı listesi alınamadı (HTTP '+xhr.status+').</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');});}
$(document).off('click','#button-ai-seo').on('click','#button-ai-seo',function(event){event.preventDefault();var selected=aiSeoSelected(),stored=sessionStorage.getItem(aiSeoQueueKey),queue=stored?JSON.parse(stored):null;if(!selected.length&&queue&&queue.current<queue.products.length){aiSeoModal('<i class="fa fa-history"></i> Yarım kalan işlem','<p><b>'+queue.current+'</b> / '+queue.products.length+' ürün işlendi. <b>'+aiSeoEscape(queue.provider||'Önceki')+'</b> sağlayıcısıyla devam etmek ister misiniz?</p>','<button type="button" class="btn btn-default ai-seo-modal-close">Vazgeç</button><button type="button" class="btn btn-primary" id="ai-seo-resume">Devam et</button>');return false;}if(!selected.length){aiSeoModal('<i class="fa fa-exclamation-circle"></i> Ürün seçin','<p>SEO üretimi için listeden en az bir ürün seçmelisiniz.</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');return false;}var token=(window.location.search.match(/[?&]user_token=([^&]+)/)||[])[1];if(!token){aiSeoModal('<i class="fa fa-exclamation-circle"></i> Oturum hatası','<p>Yönetici oturum anahtarı bulunamadı. Sayfayı yenileyip tekrar deneyin.</p>','<button type="button" class="btn btn-primary ai-seo-modal-close">Tamam</button>');return false;}aiSeoShowProviderModal(selected,decodeURIComponent(token));return false;});
//--></script>
]]></add>
    </operation>
