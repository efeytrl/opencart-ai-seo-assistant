<script type="text/javascript"><!--
(function(){function replaceCancelText(){var buttons=document.querySelectorAll('.ai-seo-modal-actions .ai-seo-modal-close.btn-default');for(var i=0;i<buttons.length;i++){if(buttons[i].textContent.replace(/\s+/g,' ').trim()==='Vazgeç'){buttons[i].setAttribute('title','Kapat');buttons[i].setAttribute('aria-label','Kapat');buttons[i].innerHTML='<i class="fa fa-times" aria-hidden="true"></i>';buttons[i].style.width='38px';buttons[i].style.paddingLeft='0';buttons[i].style.paddingRight='0';}}}new MutationObserver(replaceCancelText).observe(document.documentElement,{childList:true,subtree:true});replaceCancelText();})();
//--></script>
]]></add>
