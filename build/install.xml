  <file path="admin/view/template/catalog/category_list.twig">
    <operation>
      <search><![CDATA[<div class="pull-right">]]></search>
      <add position="after"><![CDATA[
<button type="button" id="button-ai-category-seo" class="btn btn-success" data-toggle="tooltip" title="Seçilen kategorilere AI SEO üret"><i class="fa fa-magic"></i> Kategori SEO Üret</button>
<style type="text/css">.ai-category-modal{display:none;position:fixed;z-index:10070;inset:0;padding:18px;overflow:auto;background:rgba(18,27,45,.68);backdrop-filter:blur(8px)}.ai-category-modal.open{display:flex;align-items:center;justify-content:center}.ai-category-modal-card{position:relative;width:100%;max-width:620px;max-height:calc(100vh - 36px);overflow:auto;border:1px solid rgba(255,255,255,.7);border-radius:16px;background:#fff;box-shadow:0 28px 80px rgba(4,12,24,.42)}.ai-category-modal-head{padding:22px 55px 18px 24px;background:linear-gradient(135deg,#faf8ff,#f4f9ff);border-bottom:1px solid #e6eaf1;color:#2f4058;font-size:18px;font-weight:800}.ai-category-modal-close{position:absolute;right:17px;top:15px;width:32px;height:32px;border:0;border-radius:50%;background:#fff;color:#718096;font-size:24px;box-shadow:0 2px 8px rgba(0,0,0,.1)}.ai-category-modal-body{padding:24px;color:#5d6d7e;font-size:13px;line-height:1.55}.ai-category-modal-actions{display:flex;justify-content:flex-end;gap:8px;padding:16px 24px;border-top:1px solid #e9edf2;background:#fafbfd}.ai-category-modal-actions .btn{border-radius:7px;font-weight:700}.ai-category-provider{display:grid;gap:10px;margin-top:15px}.ai-category-provider input{position:absolute;opacity:0}.ai-category-provider span{display:block;padding:13px 15px;border:1px solid #dce4ed;border-radius:9px;cursor:pointer}.ai-category-provider input:checked+span{border-color:#7753bc;background:#f7f3ff;box-shadow:0 0 0 3px rgba(119,83,188,.12)}.ai-category-progress{height:12px;margin:14px 0;border-radius:10px;overflow:hidden;background:#e6ebf1}.ai-category-progress i{display:block;height:100%;background:linear-gradient(90deg,#6946ac,#a377ee);transition:width .25s}.ai-category-results{max-height:260px;overflow:auto;border:1px solid #e1e7ee;border-radius:8px}.ai-category-results div{padding:11px 13px;border-bottom:1px solid #edf1f4}.ai-category-results div:last-child{border-bottom:0}.ai-category-score{float:right;padding:3px 7px;border-radius:10px;background:#f0ebfb;color:#6946ae;font-size:10px;font-weight:800}@media(max-width:560px){.ai-category-modal{padding:10px}.ai-category-modal-card{max-height:calc(100vh - 20px)}.ai-category-modal-actions{flex-wrap:wrap}}</style>
<script type="text/javascript"><!--
(function(){function esc(t){return $('<div>').text(t||'').html();}function modal(title,body,actions){var m=$('#ai-category-modal');if(!m.length){$('body').append('<div id="ai-category-modal" class="ai-category-modal"><div class="ai-category-modal-card"><button type="button" class="ai-category-modal-close">&times;</button><div class="ai-category-modal-head"></div><div class="ai-category-modal-body"></div><div class="ai-category-modal-actions"></div></div></div>');m=$('#ai-category-modal');$(document).on('click','.ai-category-modal-close',function(){m.removeClass('open');});}m.find('.ai-category-modal-head').html(title);m.find('.ai-category-modal-body').html(body);m.find('.ai-category-modal-actions').html(actions||'');m.addClass('open');}function selected(){return $('input[name^="selected"]:checked').map(function(){return this.value;}).get();}function token(){var hit=(location.search.match(/[?&]user_token=([^&]+)/)||[])[1];return hit?decodeURIComponent(hit):'';}function progress(q){var percent=q.ids.length?Math.round(q.current*100/q.ids.length):0;modal('<i class="fa fa-sitemap"></i> Kategori SEO üretimi','<b>'+q.current+' / '+q.ids.length+' kategori işlendi</b><div class="ai-category-progress"><i style="width:'+percent+'%"></i></div><p>Meta başlığı, açıklama, anahtar kelimeler, SEO URL ve kategori açıklaması oluşturuluyor.</p>','<button type="button" class="btn btn-default" id="ai-category-pause">Durdur</button>');}function finish(q){var html='<div class="ai-category-results">',ok=0,fail=0;$.each(q.results,function(_,r){if(r.error){fail++;html+='<div><i class="fa fa-times-circle text-danger"></i> '+esc(r.name||('Kategori #'+r.category_id))+'<small class="text-danger" style="display:block">'+esc(r.error)+'</small></div>';}else{ok++;html+='<div><i class="fa fa-check-circle text-success"></i> '+esc(r.name)+'<span class="ai-category-score">'+r.seo_score+'/100</span></div>';}});html+='</div>';modal('<i class="fa fa-check-circle"></i> Kategori üretimi tamamlandı','<p><b>'+ok+'</b> kategori tamamlandı'+(fail?', '+fail+' hata':'')+'.</p>'+html,'<button type="button" class="btn btn-primary ai-category-modal-close">Kapat</button>');$('#button-ai-category-seo').prop('disabled',false).html('<i class="fa fa-magic"></i> Kategori SEO Üret');}function run(q){if(q.paused)return;progress(q);if(q.current>=q.ids.length){finish(q);return;}$.ajax({url:'index.php?route=extension/module/ai_seo/generateCategories&user_token='+encodeURIComponent(token()),type:'post',dataType:'json',timeout:180000,data:{category_id:[q.ids[q.current]],provider:q.provider}}).done(function(json){q.results.push(json.error?{category_id:q.ids[q.current],error:json.error}:(json.results&&json.results[0]?json.results[0]:{category_id:q.ids[q.current],error:'Geçersiz yanıt.'}));q.current++;run(q);}).fail(function(xhr){q.results.push({category_id:q.ids[q.current],error:'İstek tamamlanamadı (HTTP '+xhr.status+').'});q.current++;run(q);});}$(document).on('click','#ai-category-pause',function(){window.aiCategoryQueue.paused=true;$('#ai-category-modal').removeClass('open');$('#button-ai-category-seo').prop('disabled',false).html('<i class="fa fa-history"></i> Kategori işlemine devam et');});$('#button-ai-category-seo').on('click',function(e){e.preventDefault();var ids=selected();if(!ids.length){modal('<i class="fa fa-exclamation-circle"></i> Kategori seçin','<p>SEO üretimi için listeden en az bir kategori seçmelisiniz.</p>','<button type="button" class="btn btn-primary ai-category-modal-close">Tamam</button>');return;}var t=token();if(!t){modal('Oturum hatası','<p>Yönetici oturum anahtarı bulunamadı. Sayfayı yenileyin.</p>','');return;}$.getJSON('index.php?route=extension/module/ai_seo/providers&user_token='+encodeURIComponent(t),function(json){if(json.error||!json.providers||!json.providers.length){modal('Sağlayıcı bulunamadı','<p>'+esc(json.error||'Önce en az bir API anahtarı kaydedin.')+'</p>','');return;}var opts='<div class="ai-category-provider">';$.each(json.providers,function(_,p){opts+='<label><input type="radio" name="ai_category_provider" value="'+p.id+'" '+(p.selected?'checked':'')+'><span><b>'+esc(p.label)+'</b><small>'+esc(p.model)+'</small></span></label>';});opts+='</div>';modal('<i class="fa fa-magic"></i> Kategori SEO üretimi','<p><b>'+ids.length+'</b> kategori işlenecek. Bu işlemdeki sağlayıcıyı seçin.</p>'+opts,'<button type="button" class="btn btn-default ai-category-modal-close">Vazgeç</button><button type="button" class="btn btn-primary" id="ai-category-start">Üretimi başlat</button>');$(document).off('click.aiCategoryStart','#ai-category-start').on('click.aiCategoryStart','#ai-category-start',function(){window.aiCategoryQueue={ids:ids,current:0,results:[],provider:$('input[name=ai_category_provider]:checked').val(),paused:false};$('#button-ai-category-seo').prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> SEO üretiliyor…');run(window.aiCategoryQueue);});}).fail(function(){modal('Bağlantı hatası','<p>Sağlayıcılar alınamadı.</p>','');});});})();
//--></script>
]]></add>
    </operation>
  </file>
